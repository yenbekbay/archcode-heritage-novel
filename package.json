{
  "name": "archcode-heritage-novel",
  "version": "0.0.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/yenbekbay/archcode-heritage-novel.git"
  },
  "license": "GPL-3.0",
  "author": "Ayan Yenbekbay <ayan.yenb@gmail.com>",
  "type": "module",
  "scripts": {
    "barrels-check": "pnpm run barrels-generate && git diff --quiet -- api/index.ts components/index.ts game/branches/index.ts game/commands/index.ts game/commands/internal/index.ts",
    "barrels-generate": "node scripts/generate-barrels.mjs",
    "build": "pnpm run generate-artifacts && next build",
    "css-generate": "tailwindcss -i main.css -o __generated__/main.css",
    "dev": "pnpm run generate-artifacts && pnpm run --parallel '/^dev:[^:]+$/'",
    "dev:css": "pnpm run css-generate --watch",
    "dev:next": "next dev",
    "fix": "pnpm run --sequential '/^fix:[^:]+$/'",
    "fix:eslint": "pnpm run lint:eslint --fix",
    "fix:prettier": "pnpm run lint:prettier --write",
    "generate-artifacts": "pnpm run barrels-generate && pnpm run css-generate",
    "postinstall": "if [ -z \"$CI\" ]; then simple-git-hooks; fi",
    "lint": "pnpm run generate-artifacts && pnpm run --sequential '/^lint:[^:]+$/'",
    "lint:eslint": "eslint .",
    "lint:prettier": "prettier --check --cache .",
    "lint:typecheck": "pnpm run generate-artifacts && tsc --pretty --noEmit",
    "start": "next start",
    "supabase-generate": "env-cmd --use-shell 'openapi-typescript \"${SUPABASE_URL}/rest/v1/?apikey=${SUPABASE_ANON_KEY}\" --output __generated__/supabase.ts'"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm run barrels-check && pnpm exec lint-staged && pnpm run lint:typecheck"
  },
  "dependencies": {
    "@microlink/mql": "0.10.28",
    "@radix-ui/react-dialog": "1.0.2",
    "@radix-ui/react-slot": "1.0.1",
    "@react-hookz/web": "16.0.0",
    "@supabase/supabase-js": "1.35.4",
    "disqus-react": "1.1.5",
    "embla-carousel": "7.0.3",
    "embla-carousel-react": "7.0.3",
    "embla-carousel-wheel-gestures": "3.0.0",
    "framer-motion": "7.6.1",
    "howler": "2.2.3",
    "jotai": "1.8.6",
    "next": "14.2.35",
    "next-query-params": "4.0.0",
    "next-seo": "5.6.0",
    "phosphor-react": "1.4.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-error-boundary": "3.1.4",
    "react-hot-toast": "2.4.0",
    "react-merge-refs": "2.0.1",
    "react-rough": "2.3.0",
    "react-scroll-parallax": "3.3.1",
    "react-visual-novel": "0.2.2",
    "react-zorm": "0.6.1",
    "remeda": "1.1.0",
    "rough-notation": "0.5.1",
    "roughjs": "4.5.2",
    "sharp": "^0.35.3",
    "swr": "1.3.0",
    "tailwind-merge": "1.6.2",
    "use-font-face-observer": "1.2.1",
    "use-query-params": "2.1.1",
    "zod": "3.19.1",
    "zzfx": "1.1.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.2.6",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.20",
    "@types/eslint-plugin-jsx-a11y": "^6.10.0",
    "@types/howler": "2.2.7",
    "@types/node": "^24.10.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@utilfirst/eslint-plugin": "^0.1.1",
    "@utilfirst/prettier-plugin": "^0.1.1",
    "autoprefixer": "^10.4.27",
    "browserslist-config-baseline": "^0.5.0",
    "csstype": "^3.2.3",
    "daisyui": "2.31.0",
    "env-cmd": "10.1.0",
    "eslint": "^10.8.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-tailwindcss": "3.18.2",
    "globals": "^17.9.0",
    "lint-staged": "^17.3.0",
    "openapi-typescript": "5.4.1",
    "postcss": "^8.5.14",
    "prettier": "^3.9.6",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-packagejson": "^3.0.2",
    "prettier-plugin-sh": "^0.19.0",
    "prettier-plugin-sort-json": "^4.2.0",
    "prettier-plugin-tailwindcss": "^0.7.4",
    "simple-git-hooks": "^2.13.1",
    "tailwindcss": "3.4.19",
    "tailwindcss-radix": "2.6.1",
    "tailwindcss-scrims": "1.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0"
  },
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": "24.x",
    "pnpm": "11.x"
  }
}
