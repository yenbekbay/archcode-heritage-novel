{
  "name": "archcode-heritage-novel",
  "version": "0.0.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/yenbekbay/archcode-heritage-novel.git"
  },
  "license": "GPL-3.0",
  "author": "Ayan Yenbekbay <ayan.yenb@gmail.com>",
  "type": "module",
  "imports": {
    "#*": "./src/*"
  },
  "scripts": {
    "barrels-check": "pnpm run generate:barrels && git diff --quiet -- src/api/index.ts src/components/index.ts src/game/branches/index.ts src/game/commands/index.ts src/game/commands/internal/index.ts",
    "build": "pnpm run generate && next build",
    "check": "pnpm run generate && pnpm run '/^lint:[^:]+$/'",
    "dev": "pnpm run generate && pnpm run --parallel '/^dev:[^:]+$/'",
    "dev:css": "pnpm run generate:css --watch",
    "dev:next": "next dev",
    "fix": "pnpm run --sequential '/^fix:[^:]+$/'",
    "fix:oxlint": "pnpm run lint:oxlint --fix",
    "fix:prettier": "pnpm run lint:prettier --write",
    "generate": "pnpm run --sequential '/^generate:[^:]+$/'",
    "generate:audio": "node scripts/generate-audio.mjs",
    "generate:barrels": "node scripts/generate-barrels.mjs",
    "generate:css": "tailwindcss -i src/main.css -o src/__generated__/main.css",
    "generate:next": "next typegen",
    "lint": "pnpm run generate && pnpm run '/^lint:[^:]+$/'",
    "lint:oxlint": "oxlint .",
    "lint:prettier": "prettier --check --cache .",
    "start": "next start",
    "supabase-generate": "env-cmd --use-shell 'openapi-typescript \"${SUPABASE_URL}/rest/v1/?apikey=${SUPABASE_ANON_KEY}\" --output src/__generated__/supabase.ts'"
  },
  "dependencies": {
    "@microlink/mql": "0.10.28",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-slot": "1.3.3",
    "@react-hookz/web": "16.0.0",
    "@supabase/supabase-js": "1.35.4",
    "disqus-react": "1.1.7",
    "embla-carousel": "8.6.0",
    "embla-carousel-react": "8.6.0",
    "embla-carousel-wheel-gestures": "8.1.0",
    "framer-motion": "13.1.1",
    "howler": "2.2.4",
    "jotai": "2.20.3",
    "next": "16.3.7",
    "next-query-params": "5.1.0",
    "phosphor-react": "1.4.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hot-toast": "2.6.0",
    "react-merge-refs": "3.0.2",
    "react-rough": "2.3.0",
    "react-scroll-parallax": "3.5.0",
    "react-visual-novel": "0.2.2",
    "react-zorm": "0.9.0",
    "remeda": "1.1.0",
    "rough-notation": "0.5.1",
    "roughjs": "4.6.6",
    "sharp": "0.35.4",
    "swr": "2.5.1",
    "tailwind-merge": "3.6.0",
    "use-font-face-observer": "1.3.0",
    "use-query-params": "2.2.2",
    "zod": "3.19.1",
    "zzfx": "1.3.2"
  },
  "devDependencies": {
    "@tailwindcss/forms": "0.5.11",
    "@tailwindcss/typography": "0.5.20",
    "@types/howler": "2.2.13",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@utilfirst/eslint-plugin": "0.4.8",
    "@utilfirst/prettier-plugin": "0.1.2",
    "autoprefixer": "10.5.4",
    "browserslist-config-baseline": "0.5.0",
    "csstype": "3.2.3",
    "daisyui": "2.31.0",
    "env-cmd": "11.0.0",
    "globals": "17.11.0",
    "openapi-typescript": "7.13.0",
    "oxlint": "1.80.0",
    "oxlint-tsgolint": "7.0.2001",
    "postcss": "8.5.26",
    "prettier": "3.9.6",
    "prettier-plugin-organize-imports": "4.3.0",
    "prettier-plugin-packagejson": "3.0.2",
    "prettier-plugin-sh": "0.19.0",
    "prettier-plugin-sort-json": "4.2.0",
    "prettier-plugin-tailwindcss": "0.7.4",
    "tailwindcss": "3.4.19",
    "tailwindcss-radix": "4.0.2",
    "tailwindcss-scrims": "1.0.0",
    "typescript": "6.0.3"
  },
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": "24.x",
    "pnpm": "11.x"
  }
}
